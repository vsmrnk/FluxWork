# Copy to .env.local and fill in. Dev and prod use different values for most of
# these — see docs/ENVIRONMENTS.md. Locally, always point at the dev project.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; bypasses RLS. Used by the Paddle webhook and the weekly digest.
SUPABASE_SERVICE_ROLE_KEY=

# Paddle Billing
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
# sandbox | production
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Optional: hosted customer-portal link shown to Pro users on /plan.
NEXT_PUBLIC_PADDLE_CUSTOMER_PORTAL_URL=
PADDLE_WEBHOOK_SECRET=
# Read only by `npm run paddle:setup`, never at runtime.
PADDLE_API_KEY=

# Auth email: Supabase Send Email hook -> /api/auth/send-email -> Resend
# v1,whsec_... from Supabase -> Auth -> Hooks -> Send Email
AUTH_EMAIL_HOOK_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=FluxWork <noreply@example.com>
# App origin for confirmation links and the digest's "Open FluxWork" button.
AUTH_EMAIL_SITE_URL=http://localhost:3000

# Weekly digest: Vercel Cron sends this as a Bearer token to /api/digest.
CRON_SECRET=

# Test user for `npm run verify` and `npm run verify:snapshot` (dev database only).
TEST_EMAIL=
TEST_PASSWORD=
